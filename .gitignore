# ===================================================================
# Secrets: never commit real keys or credentials
# ===================================================================
.env
.env.*
!.env.example
*.pem
*.key
credentials*.json
client_secret*.json
token*.json

# ===================================================================
# Python
# ===================================================================
__pycache__/
*.py[cod]
*.so
*.egg-info/
.eggs/
build/
dist/
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
.coverage.*
htmlcov/
.ipynb_checkpoints/

# Virtual environments, any name, anywhere
# (service/rip/ was a committed Windows venv: 3,463 files, ~62 MB)
rip/
.venv/
venv/
env/
ENV/
.venv*/
venv*/
pyvenv.cfg

# ===================================================================
# Node / Next.js
# ===================================================================
node_modules/
.next/
out/
next-env.d.ts
*.tsbuildinfo
.turbo/
.vercel/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# ===================================================================
# Runtime caches and outputs produced by the app
# ===================================================================
# LLM replay cache: holds prompts and responses from real runs
service/.replay_cache/
.replay_cache/
# Eval harness LLM result cache (rebuilt by running the eval)
service/eval/eval_cache.json
# Ad-hoc scan outputs saved from the API
/scan*.json
# Logs and local databases (demo.db is whitelisted below)
*.log
*.sqlite
*.sqlite3
*.db
!service/demo_data/demo.db

# ===================================================================
# Scratch and duplicate files
# ===================================================================
# test2/ is an exact copy of service/eval/datasets/versions/
/test2/
# Hand-made test CSVs in the service root (tests build their own)
/service/accounts.csv
/service/contacts.csv
/service/leads.csv
/service/leads2.csv
/service/notes_test.csv

# ===================================================================
# Editors and OS
# ===================================================================
.vscode/
.idea/
*.swp
*.swo
.DS_Store
Thumbs.db
desktop.ini
